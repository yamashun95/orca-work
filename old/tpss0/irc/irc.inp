! TPSS0 def2-TZVP RIJCOSX TightSCF SlowConv IRC

%pal
  nprocs 16
end

%maxcore 4000

%scf
  MaxIter 300
end

%cpcm
  smd false
  solvent "water"
end

%irc
  Direction both
  MaxIter 120
  PrintLevel 1

  hessMode 0
  Scale_Init_Displ 0.1

  Scale_Displ_SD 0.22
  Adapt_Scale_Displ true
  SD_ParabolicFit true
  Interpolate_only true
  Do_SD_Corr true
  Scale_Displ_SD_Corr 0.333
  SD_Corr_ParabolicFit true
end

* xyzfile 0 1 tsopt_ts.xyz
